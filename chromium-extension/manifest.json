{
  "manifest_version": 3,
  "name": "Waterloo LEARN Reader",
  "version": "0.4.0",
  "description": "Read requested LEARN data on this computer. Never exports cookies or passwords.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.uwaterloo.ca/d2l/home*"
      ],
      "js": [
        "policy.js",
        "reader.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:18766 https://learn.uwaterloo.ca"
  },
  "host_permissions": [
    "https://learn.uwaterloo.ca/*",
    "http://127.0.0.1:18766/*"
  ],
  "action": {
    "default_title": "Waterloo Safari Reader",
    "default_popup": "popup.html"
  }
}
